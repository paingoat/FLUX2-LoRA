# Copy to .env and paste a token from https://huggingface.co/settings/tokens
# The klein weights used here are public. The token raises the Hub rate limit.
HF_TOKEN=hf_your_token_here
HF_HOME=/backup/data/art-gen
HF_HUB_CACHE=/backup/data/art-gen/hub
HF_XET_CACHE=/backup/data/art-gen/xet
HF_ASSETS_CACHE=/backup/data/art-gen/assets
